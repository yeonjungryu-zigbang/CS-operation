# Slack 설정
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token  # Socket Mode 사용 시 필요

# Anthropic Claude API
ANTHROPIC_API_KEY=your-anthropic-api-key

# Google Service Account (JSON 전체를 한 줄로)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# 서버 포트 (기본 3000)
PORT=3000

# 스마트홈 KPI 대시보드 로컬 서버 (dashboard_server.py) - zigbang.com 계정 로그인 게이트
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서 OAuth 클라이언트 ID(웹 애플리케이션) 생성,
# 승인된 리디렉션 URI에 http://localhost:5050/oauth2callback 등록 후 아래에 값 채우기
GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret
FLASK_SECRET_KEY=랜덤한-긴-문자열로-직접-생성해서-채우기
DASHBOARD_PORT=5050
